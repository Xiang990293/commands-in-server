{
    "title": "新增傳送殿堂",
    "external_title": {"text": "你會獲得一個能傳送至你指定位置的按鈕放置精靈", "color":"yellow"},
    "after_action": "close",
    "type": "multi_action",
    "body": [
        {
            "type": "plain_message",
            "contents": {"text": "輸入位置資訊"}
        }
    ],
    "inputs": [
        {
            "key": "endpoint_name",
            "label": {"text": "地點名稱:"},
            "label_visible": true,
            "type": "text",
            "initial": "傳送點",
            "max_length": 20
        },
        {
            "key": "dimension",
            "label": {"text": "維度: (請勿任意更動)", "color": "gold"},
            "label_visible": true,
            "type": "text",
            "initial": "minecraft:overworld",
            "max_length": 50
        },
        {
            "key": "position_x",
            "label": {"text": "x:", "color": "red"},
            "label_visible": true,
            "type": "text",
            "initial": "0.0",
            "max_length": 15
        },
        {
            "key": "position_y",
            "label": {"text": "y:", "color": "green"},
            "label_visible": true,
            "type": "text",
            "initial": "0.0",
            "max_length": 15
        },
        {
            "key": "position_z",
            "label": {"text": "z:", "color": "blue"},
            "label_visible": true,
            "type": "text",
            "initial": "0.0",
            "max_length": 15
        }
    ],
    "columns": 1,
    "actions": [
        {
            "label": "確定",
            "tooltip": {"text": "取得按鈕放置精靈"},
            "action": {
                "type": "dynamic/run_command",
                "template": "give @p minecraft:stone_button[minecraft:item_name={\"text\":\"傳送按鈕\",\"color\":\"#ea00ff\",\"italic\":false},minecraft:enchantment_glint_override=true,minecraft:custom_data={dimension:\"$(dimension)\",x:$(position_x),y:$(position_y),z:$(position_z),name:\"$(endpoint_name)\",type: \"endpoint_button\"}]"
            }
        }
    ]
}